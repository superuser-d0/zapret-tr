<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ZapretTr.Prober\ZapretTr.Prober.csproj" />
    <ProjectReference Include="..\ZapretTr.Core\ZapretTr.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zapret-tr-test</AssemblyName>
    <RootNamespace>ZapretTr.Prober.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Kırpma. Bir kez denenip GERİ ALINMIŞTI: JSON yansımayla çalışıyordu ve kırpma,
      DNS yedeğinin geri yüklenmesi gibi güvenlik açısından kritik yolları SESSİZCE
      bozabiliyordu. Şimdi güvenli, çünkü bütün JSON yolları kaynak üretimine taşındı
      (CoreJsonContext, ProberJsonContext, ReportJsonContext) ve aşağıdaki iki bayrak
      bunu ZORLUYOR: yeni bir yansıma yolu eklenirse yayın uyarı değil HATA verir.

      Bu iki satırı kaldırmadan önce bunu oku: kırpmanın güvenliği "dikkatli olduk"a
      değil, TrimmerSingleWarn=false + WarningsAsErrors'a dayanıyor.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <!-- msquic.dll tek dosya paketinin DIŞINDA kalıyor: Directory.Build.targets. -->

</Project>




