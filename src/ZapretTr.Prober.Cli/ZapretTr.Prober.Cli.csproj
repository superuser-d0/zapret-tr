<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ZapretTr.Prober\ZapretTr.Prober.csproj" />
    <ProjectReference Include="..\ZapretTr.Core\ZapretTr.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zapret-tr-test</AssemblyName>
    <RootNamespace>ZapretTr.Prober.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Kirpma. Bir kez denenip GERI ALINMISTI: JSON yansimayla calisiyordu ve kirpma,
      DNS yedeginin geri yuklenmesi gibi guvenlik kritik yollari SESSIZCE bozabiliyordu.
      Simdi guvenli, cunku butun JSON yollari kaynak uretimine tasindi (CoreJsonContext,
      ProberJsonContext, ReportJsonContext) ve asagidaki iki bayrak bunu ZORLUYOR:
      yeni bir yansima yolu eklenirse yayin uyari degil HATA verir.

      Bu iki satiri kaldirmadan once bunu oku: kirpmanin guvenligi "dikkatli olduk"a
      degil, TrimmerSingleWarn=false + WarningsAsErrors'a dayaniyor.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <!-- msquic.dll tek dosya paketinin DISINDA kaliyor: Directory.Build.targets. -->

</Project>




