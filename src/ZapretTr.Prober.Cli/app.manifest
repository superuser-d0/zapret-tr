<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ZapretTR.ProberCli" />

  <!--
    winws.exe çekirdek modunda çalışan WinDivert sürücüsünü kullanıyor ve
    yükseltilmiş yetki olmadan başlatılamıyor. Yetkiyi sonradan istemek diye bir
    seçenek olmadığı için araç baştan yönetici olarak başlatılıyor: saha testini
    yapan kişi "neden çalışmadı" diye uğraşmasın, UAC penceresi doğrudan çıksın.

    NOT: Bu dosyayı düzenlerken yorumların içinde çift tire kullanma. XML
    yorumları çift tire içeremez; SxS yükleyicisi dosyayı reddeder ve uygulama
    "side-by-side configuration is incorrect" ile hiç açılmaz. Derleme bu hatayı
    YAKALAMAZ.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 ve 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
