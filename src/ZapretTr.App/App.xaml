<Application x:Class="ZapretTr.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Durum bandi renkleri. Durumu yaziyla birlikte renkle de anlatmak,
             kullanicinin pencereye bir saniye bakip "acik mi kapali mi" sorusunu
             cevaplayabilmesi icin. Renk TEK basina anlam tasimiyor: her durumda
             yazi da degisiyor, boylece renk ayrimi gucluk ceken kullanicilar da
             ayni bilgiyi aliyor. -->
        <SolidColorBrush x:Key="StatusReadyBrush"   Color="#E8EEF7" />
        <SolidColorBrush x:Key="StatusRunningBrush" Color="#D8F0DC" />
        <SolidColorBrush x:Key="StatusPausedBrush"  Color="#FBEBD0" />
        <SolidColorBrush x:Key="StatusTestingBrush" Color="#DCE8FA" />
        <SolidColorBrush x:Key="StatusFaultedBrush" Color="#F8DEDE" />

        <SolidColorBrush x:Key="AccentBrush"     Color="#1F5FAF" />
        <SolidColorBrush x:Key="TextMutedBrush"  Color="#6B7280" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D4D9E0" />
        <SolidColorBrush x:Key="WarningBrush"    Color="#9A6212" />
        <SolidColorBrush x:Key="WarningBackBrush" Color="#FDF3E0" />

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- Ikincil islem dugmesi: liste halinde alt alta duran, esit agirlikta olanlar. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FBFCFD" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF3FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ana dugme: pencerede gorsel olarak baskin olmasi gereken tek eylem. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Yikici islem: gorunusu kullaniciyi bir an durdurmali. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#A32020" />
            <Setter Property="BorderBrush" Value="#E3B8B8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </Application.Resources>
</Application>
