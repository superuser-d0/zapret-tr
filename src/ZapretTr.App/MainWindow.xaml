<Window x:Class="ZapretTr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZapretTr.App.ViewModels"
        xmlns:local="clr-namespace:ZapretTr.App"
        Title="{Binding WindowTitle}" Height="800" Width="440"
        MinHeight="600" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Üst kısım kayabiliyor, günlük ve alt bilgi her zaman görünüyor. Düz bir
         Grid'ken varsayılan boyutta "Çıkış" yarım kalıyor, "Ayrıntılar" ve alt
         bilgi hiç görünmüyordu (0.1.21, gerçek kurulumda ölçüldü). Gerekçesi
         SigdirmaPaneli'nde. -->
    <local:SigdirmaPaneli Margin="16,12,16,10">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <!-- Kaydırma çubuğu çıktığında düğmelerin kenarına yapışmasın. -->
                    <Style.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>

                <!-- ================= DURUM BANDI =================
                     Ekrandaki referansta burası yalnızca "SİSTEM HAZIR" yazıyor.
                     Burada ek olarak hangi İSS'nin ve hangi stratejinin seçili olduğu ve
                     stratejinin doğrulanıp doğrulanmadığı da gösteriliyor: kullanıcının
                     "açık mı, neyle açık, güveneyim mi" sorularının üçüne de tek bakışta
                     cevap vermesi için. -->
                <Border CornerRadius="6" Padding="14,12" Margin="0,0,0,14"
                        Background="{Binding StatusBrushKey, Converter={x:Static local:ResourceKeyConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusHeadline}"
                                   FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding StatusDetail}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ================= ANA EYLEM ================= -->
                <StackPanel Margin="0,0,0,14">
                    <Button Content="{Binding PrimaryButtonText}"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}" />

                    <!-- Referans arayüzde durdurma ayrı bir durum değil, tek düğme
                         başla/durdur arasında gidip geliyor. Burada duraklatma ayrı:
                         yapılandırmayı kaybetmeden geçici olarak kapatmak, "internetim
                         bozuldu, bir şeyi kapatayım" anında en çok istenen şey. -->
                    <Button Content="Duraklat"
                            Command="{Binding PauseCommand}"
                            Style="{StaticResource ActionButton}"
                            Margin="0,8,0,0" />
                </StackPanel>

                <!-- ================= SEÇİMLER ================= -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Referansta yalnızca hazır "Strateji" listesi var. Servis
                         sağlayıcısı burada birinci sınıf alan: aramayı hızlandıran
                         şey tam olarak bu seçim. -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Servis Sağlayıcı:" Style="{StaticResource LabelText}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding IspChoices}"
                              SelectedItem="{Binding SelectedIsp}"
                              DisplayMemberPath="Display" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Strateji:" Style="{StaticResource LabelText}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding StrategyChoices}"
                              SelectedItem="{Binding SelectedStrategy}"
                              DisplayMemberPath="Display" />

                    <!-- Etiket ve ipucu eskiden yalnızca TESTTEN bahsediyordu; kutunun
                         adresi KORUMAYA da eklediğini söylemiyordu. Gerçek kullanıcı
                         (issue #1, KeremKuyucu) "ekstra site eklemeyi bulamadım" dedi ve
                         haklıydı: özellik vardı, ama böyle sunulmuyordu. -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Açılmayan site:" Style="{StaticResource LabelText}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Height="28" Padding="6,4" Margin="0,0,0,8"
                             VerticalContentAlignment="Center"
                             Text="{Binding CustomTarget, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Sizde açılmayan bir adres yazın (örnek: roblox.com).&#10;Bu adres hem testte denenir HEM DE koruma açıkken stratejinin uygulandığı adresler listesine eklenir.&#10;TEK adres yazın; şimdilik birden fazla adres desteklenmiyor.&#10;Boş bırakılırsa varsayılan hedefler kullanılır." />

                    <!-- Şifreli DNS anahtarı. Varsayılan AÇIK ve bu ölçülmüş bir gerekçeye
                         dayanıyor: bu makinede discord.com, pornhub.com ve xvideos.com'un
                         üçü de sağlayıcının engel sunucusuna çözümleniyordu. O katman
                         aşılmadan winws stratejisi hiçbir şey değiştirmiyor; trafik
                         zaten gerçek sunucuya gitmiyor. -->
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                              IsChecked="{Binding IsSecureDnsEnabled}"
                              Content="Şifreli DNS kullan (önerilir)"
                              ToolTip="Servis sağlayıcınız DNS cevaplarını değiştiriyorsa, tek başına DPI atlatma yetmez. Bu seçenek dnscrypt-proxy'yi çalıştırır ve sistem DNS'ini ona yönlendirir. Uygulamayı kapattığınızda ayarınız eski haline döner." />

                    <!-- Doğrulanma rozeti. Profil verisinin büyük kısmı bizim test
                         etmediğimiz adaylardan oluşuyor; "denenmeye değer" ile
                         "çalışıyor" arasındaki farkı gizlemek, işe yaramadığında
                         güveni tümden yıkardı. -->
                    <Border Grid.Row="4" Grid.Column="1"
                            Visibility="{Binding IsSelectedStrategyUnverified, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource WarningBackBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8,5">
                        <TextBlock Text="{Binding VerificationNote}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </Grid>

                <!-- ================= PARAMETRE TESTİ ================= -->
                <StackPanel Margin="0,0,0,12">
                    <Button Content="PARAMETRE TESTİ YAP"
                            Command="{Binding TestCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" />

                    <Grid Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                          Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Row="0" Grid.Column="0" Height="6"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding ProgressFraction, Mode=OneWay}" />

                        <Button Grid.Row="0" Grid.Column="1" Content="İptal"
                                Command="{Binding CancelTestCommand}"
                                Style="{StaticResource ActionButton}"
                                Height="22" Margin="8,0,0,0" Padding="8,0" FontSize="11" />

                        <!-- Hangi aşamada olduğunu yazmak, belirsiz bir çubuktan çok daha
                             iyi: kullanıcı "İSS profilimde mi, genel aramada mı" bilirse
                             beklemeye değer olup olmadığına kendisi karar verebilir. -->
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </Grid>
                </StackPanel>

                <!-- ================= DİĞER İŞLEMLER ================= -->
                <StackPanel>
                    <!-- Yeni sürüm varsa: görülür ama rahatsız etmeyen bir satır. -->
                    <Border Background="{DynamicResource UpdateBackBrush}" BorderBrush="{DynamicResource UpdateBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding UpdateMessage}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource UpdateTextBrush}" />
                            <TextBlock Text="github.com/superuser-d0/zapret-tr/releases"
                                       FontSize="11" Foreground="{DynamicResource UpdateSubTextBrush}" TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                            <Button Content="İndir ve Kur"
                                    Command="{Binding UpdateCommand}"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,8,0,0" Padding="14,6"
                                    ToolTip="Paketi indirir, SHA256 özetini doğrular ve kurulumu başlatır." />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding ServiceButtonText}"
                            Command="{Binding ServiceCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Bilgisayar açıldığında ZapretTR kendiliğinden çalışsın. Şu anki ayarınız kullanılır; sonradan değiştirirseniz servisi yeniden kurmanız gerekir." />
                    <!-- Bu düğme önce "Ayrıntılar" panelinin İÇİNDE duruyordu; bağlamı
                         orası diye. Yanlıştı: WPF kapalı bir Expander'ın içeriğini görsel
                         ağaca hiç eklemiyor, dolayısıyla düğme paneli açmayan kullanıcı
                         için YOKTU. Gerçek bir kurulumda da tam olarak bu yaşandı.
                         Bulunamayan bir düğmenin bağlamı da olmaz. -->
                    <Button Content="Güncellemeleri Denetle"
                            Command="{Binding UpdateCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Yeni sürüm var mı diye bakar; varsa indirip kurar. GitHub'a yalnızca sürüm sorusu gider." />
                    <Button Content="Raporu Kaydet"
                            Command="{Binding SaveReportCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Günlüğü ve ortam özetini bir dosyaya yazar. Hiçbir yere gönderilmez; neyi paylaşacağınıza siz karar verirsiniz." />
                    <Button Content="Hata Bildir"
                            Command="{Binding ReportIssueCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="GitHub'da hata bildirimi formunu doldurulmuş halde açar. Gönderilmez; okuyup siz gönderirsiniz." />
                    <Button Content="Tüm Ayarları Sıfırla"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource DangerButton}" />
                    <Button Content="Çıkış"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource ActionButton}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= CANLI GÜNLÜK + TEMA =================
             Günlük referans arayüzde yok. Burada var ve varsayılan olarak kapalı:
             normalde gürültü, ama bir şey çalışmadığında kullanıcının elindeki
             tek kanıt bu. Testte kendiliğinden açılıyor.

             Tema düğmesi "Ayrıntılar" başlığının sağındaki boş yerde: yeni bir satır
             pencerenin varsayılan boyutta sığmasını yeniden bozardı (800'de boşluk
             sıfır). Düğme Expander'ın ÜSTÜNDE duruyor, içinde değil; kapalı bir
             Expander'ın içindeki düğme kullanıcı için yoktur. -->
        <Grid>
            <Expander Header="Ayrıntılar" Margin="0,12,0,0"
                      IsExpanded="{Binding IsLogExpanded}">
                <Border Background="{DynamicResource LogBackBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                    <!-- Satır dolgusu ve seçim rengi temadaki ListBoxItem stilinde.
                         Burada ItemContainerStyle verilirse koyu temanın stilini ezer. -->
                    <ListBox ItemsSource="{Binding LogLines}"
                             local:AutoScrollBehavior.AutoScroll="True"
                             BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             MinHeight="120" />
                </Border>
            </Expander>

            <Button Content="{Binding ThemeButtonText}"
                    Command="{Binding ToggleThemeCommand}"
                    Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="22" Margin="0,12,0,0" Padding="10,0" FontSize="11"
                    ToolTip="Arayüzü koyu ya da açık renge çevirir. Seçiminiz saklanır." />
        </Grid>

        <!-- ================= ALT BİLGİ ================= -->
        <TextBlock Text="{Binding FooterText}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </local:SigdirmaPaneli>
</Window>
