<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ZapretTr.Prober\ZapretTr.Prober.csproj" />
    <ProjectReference Include="..\ZapretTr.Core\ZapretTr.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Yalnizca bildirim alani simgesi (NotifyIcon) icin: WPF'in kendi
         bildirim alani API'si yok ve tek bir simge icin ucuncu taraf paket
         almak guvendigimiz kod miktarini bosuna buyutur. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ZapretTR</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms YALNIZCA NotifyIcon icin acildi. Ortulu using olarak gelirse
         Application ve ListBox gibi adlar WPF karsiliklariyla cakisiyor ve
         mevcut dosyalar derlenmiyor. Ad alani, ihtiyaci olan tek dosyada
         (TrayIcon.cs) acikca yaziliyor. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

