<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ZapretTr.Prober\ZapretTr.Prober.csproj" />
    <ProjectReference Include="..\ZapretTr.Core\ZapretTr.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Yalnızca bildirim alanı simgesi (NotifyIcon) için: WPF'in kendi
         bildirim alanı API'si yok ve tek bir simge için üçüncü taraf paket
         almak güvendiğimiz kod miktarını boşuna büyütür. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ZapretTR</AssemblyName>

    <!-- Exe, görev çubuğu ve pencere başlığı bu simgeyi kullanıyor. Önceden
         yoktu ve her yerde .NET'in varsayılan simgesi görünüyordu. Dosya
         tools/make-icon.ps1 ile üretiliyor. -->
    <ApplicationIcon>Assets\ZapretTR.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Yayın TEK DOSYA: ZapretTR.dll, ZapretTr.Core.dll ve ZapretTr.Prober.dll exe'nin
    içine giriyor. Sebep kod imzası yokluğu, boyut değil.

    Akıllı Uygulama Denetimi (Smart App Control) açık bir makinede 0.2.0 şu
    bildirimle çalışmadı (2026-09-15, kullanıcıdan ekran görüntüsü):
      "Bu uygulamanın bir kısmı engellendi ... uygulamayı kimin yayımladığını
       doğrulayamadığımızdan ZapretTR.dll"
    Bu bir antivirüs tespiti değil: SAC her imzasız PE dosyasını yüklenirken ayrı
    ayrı itibara soruyor ve her sürümde özeti değişen, az indirilmiş bir dosyanın
    itibarı yok. Yayındaki 244 dosyadan yalnızca dördü imzasızdı (exe + bu üç DLL);
    geri kalanı Microsoft imzalı .NET/WPF dosyalarıydı.

    Tek dosyada yönetilen derlemeler paketin içinden belleğe eşlendiği için diskte
    imzasız DLL kalmıyor; itibar sorulan tek dosya exe. IncludeNativeLibrariesForSelfExtract
    KAPALI: yerel kütüphaneler (hepsi Microsoft imzalı) exe'nin yanında gerçek dosya
    olarak kalıyor, %TEMP%'e çıkarma yok. Sıkıştırma KAPALI: sıkıştırılmış paket
    antivirüs makine öğrenmesine "paketleyici" gibi görünüyor, kazancı da birkaç MB.

    Koşul: RuntimeIdentifier yalnızca yayında veriliyor. Testler bu projeyi RID'siz
    derliyor; koşulsuz PublishSingleFile orada NETSDK1097 hatası veriyor.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bildirim alanı için ayrıca gömülü: exe'den çıkarılan simge tek bir
         32x32 görüntü ve 16x16'ya küçültülünce bulanıklaşıyor. Gömülü .ico'dan
         Windows'un istediği boyut doğrudan seçiliyor. -->
    <EmbeddedResource Include="Assets\ZapretTR.ico" LogicalName="ZapretTR.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms YALNIZCA NotifyIcon için açıldı. Örtülü using olarak gelirse
         Application ve ListBox gibi adlar WPF karşılıklarıyla çakışıyor ve
         mevcut dosyalar derlenmiyor. Ad alanı, ihtiyacı olan tek dosyada
         (TrayIcon.cs) açıkça yazılıyor. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

