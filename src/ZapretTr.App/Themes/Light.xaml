<!-- Açık tema. Değerler koyu tema eklenmeden önceki arayüzün renklerinin birebir
     aynısı: açık temada görünen hiçbir şey değişmesin.

     İki temada da AYNI anahtarlar olmalı (ThemeDictionaryTests bunu denetliyor).
     Eksik bir anahtar tema değişince o öğeyi eski renginde bırakır ya da
     StaticResource ise pencereyi hiç kurmaz. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Light</sys:String>

    <!-- Durum bandı renkleri. Renk TEK başına anlam taşımıyor: her durumda yazı da
         değişiyor, böylece renk ayrımında güçlük çeken kullanıcılar da aynı bilgiyi alıyor. -->
    <SolidColorBrush x:Key="StatusReadyBrush"   Color="#E8EEF7" />
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#D8F0DC" />
    <SolidColorBrush x:Key="StatusPausedBrush"  Color="#FBEBD0" />
    <SolidColorBrush x:Key="StatusTestingBrush" Color="#DCE8FA" />
    <SolidColorBrush x:Key="StatusFaultedBrush" Color="#F8DEDE" />

    <SolidColorBrush x:Key="WindowBackBrush"   Color="#F4F6F9" />
    <SolidColorBrush x:Key="TextBrush"         Color="#000000" />
    <SolidColorBrush x:Key="TextMutedBrush"    Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush"       Color="#1F5FAF" />
    <SolidColorBrush x:Key="BorderBrushSoft"   Color="#D4D9E0" />

    <SolidColorBrush x:Key="ControlBackBrush"  Color="#FBFCFD" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF3FA" />
    <SolidColorBrush x:Key="PrimaryBackBrush"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackBrush"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush"  Color="#ABADB3" />
    <SolidColorBrush x:Key="SelectedBackBrush" Color="#CCE8FF" />
    <SolidColorBrush x:Key="LogBackBrush"      Color="#FFFFFF" />

    <SolidColorBrush x:Key="DangerTextBrush"   Color="#A32020" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E3B8B8" />

    <SolidColorBrush x:Key="WarningBrush"       Color="#9A6212" />
    <SolidColorBrush x:Key="WarningBackBrush"   Color="#FDF3E0" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#EBD6AE" />

    <SolidColorBrush x:Key="UpdateBackBrush"    Color="#FFF8E1" />
    <SolidColorBrush x:Key="UpdateBorderBrush"  Color="#FFE0A3" />
    <SolidColorBrush x:Key="UpdateTextBrush"    Color="#7A5A00" />
    <SolidColorBrush x:Key="UpdateSubTextBrush" Color="#8A6D3B" />

    <!-- Açık temada standart kontrollerin Windows görünümü korunuyor; yalnızca
         önceden App.xaml'da duran boyut ayarları burada. -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="4,1" />
    </Style>

</ResourceDictionary>
