<Project>

  <!--
    Sürüm TEK yerde. Önceden yalnızca installer/setup.iss biliyordu; üretilen
    exe'lerin üzerinde hiçbir sürüm bilgisi yoktu, dolayısıyla kullanıcının
    "hangi sürümü çalıştırıyorum" sorusunun makinede cevabı yoktu.

    Yayın akışı bunu etiketten geçiriyor: dotnet'e -p:Version=, ISCC'ye /DAppVersion=.
    İkisi de verilmezse buradaki değer kullanılır.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.2.7</Version>
    <Company>ZapretTR</Company>
    <Product>ZapretTR</Product>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

</Project>
